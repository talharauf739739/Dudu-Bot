# ══════════════════════════════════════════════════════════════════════════════
# ForgeX AI — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git
# ══════════════════════════════════════════════════════════════════════════════

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── TradeLocker (DEMO) ────────────────────────────────────────────────────────
# Sign up at: https://tradelocker.com  →  create DEMO account
TRADELOCKER_BASE_URL=https://demo.tradelocker.com/backend-api
TRADELOCKER_EMAIL=your@email.com
TRADELOCKER_PASSWORD=your_password
TRADELOCKER_SERVER=OSP-DEMO         # Server name shown in TradeLocker app
TRADELOCKER_ACCOUNT_ID=123456       # Numeric account ID from TradeLocker

# ── TradingView ───────────────────────────────────────────────────────────────
# Webhook secret — set any random string, paste same in Pine Script alert
TRADINGVIEW_WEBHOOK_SECRET=your_random_secret_here
# Port the webhook receiver listens on (inside mcp-tradingview server)
TRADINGVIEW_WEBHOOK_PORT=8001

# ── ForexFactory / NewsAPI ────────────────────────────────────────────────────
# NewsAPI key: https://newsapi.org/register  (free tier ok)
NEWSAPI_KEY=your_newsapi_key_here

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot
# 2. Copy the token below
# 3. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  → copy your chat_id
TELEGRAM_BOT_TOKEN=123456789:ABC-your-telegram-bot-token
TELEGRAM_CHAT_ID=your_chat_id_as_integer

# ── Google (Drive / Sheets) ───────────────────────────────────────────────────
# Google Drive is already connected via Claude MCP workspace
# You only need the Sheet ID from the URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_DRIVE_SHEET_ID=your_google_sheet_id_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local PostgreSQL. Install: brew install postgresql / apt install postgresql
# Create DB: createdb forgex_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/forgex_db

# ── Active Prop Firm & Account ────────────────────────────────────────────────
# Which firm account is currently active for trading
# Options: FundedNext | FXIFY | FundingPips | E8Markets | FTMO | The5ers
ACTIVE_PROP_FIRM=FundedNext
ACTIVE_ACCOUNT_ID=123456

# ── Session Windows (GMT) ─────────────────────────────────────────────────────
SESSION_LONDON_START=08:00
SESSION_LONDON_END=12:00
SESSION_NY_START=13:30
SESSION_NY_END=21:00

# ── Risk Parameters ───────────────────────────────────────────────────────────
# Max % of account risked per trade (Agent-04 check #5)
MAX_RISK_PER_TRADE_PCT=1.0
# Minimum setup score to pass Agent-02 filter (out of 10)
MIN_SIGNAL_SCORE=7.5
# Minimum win rate required to approve a strategy (Agent-04 check #8)
MIN_WIN_RATE_PCT=65.0

# ── MetaTrader 5 / Broker ────────────────────────────────────────────────────
# MT5 only works on Windows. Leave blank on macOS/Linux.
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Trial8          # Use Exness-MT5Real8 for live
MT5_TERMINAL_PATH=                   # e.g. C:\Program Files\MetaTrader 5\terminal64.exe

# ── Exness ─────────────────────────────────────────────────────────────────────
EXNESS_LOGIN=12345678
EXNESS_PASSWORD=your_exness_password
EXNESS_SERVER=Exness-MT5Trial8       # Trial = demo, Real8 = live
EXNESS_ACCOUNT_TYPE=standard         # standard | micro (affects symbol suffix)

# ── FastAPI ───────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
